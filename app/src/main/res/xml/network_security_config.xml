<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- JARVIS Browser is a general-purpose browser, so HTTP sites must load.
         API traffic itself always uses HTTPS (Gemini endpoints). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
