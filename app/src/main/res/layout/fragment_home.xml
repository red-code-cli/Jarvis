<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/techBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ref_circuit"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/homeInputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="2dp"
            android:paddingEnd="18dp"
            android:paddingBottom="120dp">

            <!-- Greeting and live badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreetingPrefix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:includeFontPadding="false"
                        android:text="Good evening,"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGreetingName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:includeFontPadding="false"
                        android:text="dost"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Particle orb + reference HUD ring -->
            <FrameLayout
                android:id="@+id/orbContainer"
                android:layout_width="match_parent"
                android:layout_height="196dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.jarvis.assistant.ui.widget.OrbRingView
                    android:id="@+id/orbRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <WebView
                    android:id="@+id/orbWebView"
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:contentDescription="Jarvis orb — tap to talk"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.22"
                        android:text="AI ASSISTANT"
                        android:textColor="#AA24395F"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrbName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-rounded"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.10"
                        android:text="J.A.R.V.I.S"
                        android:textColor="?attr/themeAccent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrbStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.16"
                        android:text="TAP TO TALK"
                        android:textColor="#B33D5578"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Live error card floats over the orb -->
                <LinearLayout
                    android:id="@+id/cardLiveError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_ref_error_card"
                    android:clickable="true"
                    android:elevation="30dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivLiveErrorIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Error"
                            android:src="@drawable/ic_warning"
                            app:tint="#EF4444" />

                        <TextView
                            android:id="@+id/tvLiveErrorTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="API KEY ERROR"
                            android:textColor="#EF4444"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnDismissLiveError"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Dismiss"
                            android:src="@drawable/ic_close"
                            app:tint="?attr/themeTextMuted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLiveErrorMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:text="Google rejected the API key: 400 Bad Request. Please update your API key in Settings."
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnFixLiveError"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_ref_blue_button"
                        android:paddingHorizontal="20dp"
                        android:text="OPEN API SETTINGS"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </FrameLayout>

            <!-- Agent Live: the only place agent activity is shown (the orb stays voice-only) -->
            <LinearLayout
                android:id="@+id/cardAgentLive"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ref_card"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="AGENT LIVE"
                        android:textColor="?attr/themeAccent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAgentLiveChip"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_jarvis_status_badge"
                        android:gravity="center"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:text="IDLE"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvAgentLiveQueued"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_jarvis_status_badge"
                        android:gravity="center"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:text="+0 queued"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAgentLiveProject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-rounded"
                    android:maxLines="1"
                    android:text="Koi kaam nahi chal raha"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAgentLiveMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Bolo: Jarvis ek app banao"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pbAgentLive"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="?attr/themeAccent"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Real status cards: weather, date, battery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardWeather"
                    android:layout_width="0dp"
                    android:contentDescription="Mausam — live weather. Tap to refresh."
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ref_card"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Weather"
                            android:src="@drawable/ic_weather_sun"
                            app:tint="?attr/themeAccent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="sans-serif"
                            android:text="Mausam"
                            android:textColor="?attr/themeTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-rounded"
                        android:includeFontPadding="false"
                        android:text="--°C"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWeatherCondition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Locating…"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvWeatherDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Tap to refresh"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardDate"
                    android:layout_width="0dp"
                    android:contentDescription="Aaj — today's date. Tap to open calendar."
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ref_card"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Date"
                            android:src="@drawable/ic_calendar"
                            app:tint="?attr/themeAccent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="sans-serif"
                            android:text="Aaj"
                            android:textColor="?attr/themeTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDateDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-rounded"
                        android:includeFontPadding="false"
                        android:text="--"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDateMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Today"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDateMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardBattery"
                    android:layout_width="0dp"
                    android:contentDescription="Battery — live battery status. Tap for battery usage."
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ref_card"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Battery"
                            android:src="@drawable/ic_battery"
                            app:tint="?attr/themeAccent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="sans-serif"
                            android:text="Battery"
                            android:textColor="?attr/themeTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBatteryPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-rounded"
                        android:includeFontPadding="false"
                        android:text="--%"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBatteryStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Checking"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvBatteryHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Phone ready"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Reference message bar -->
    <LinearLayout
        android:id="@+id/homeInputBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_ref_input"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnHomeAttach"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share screen with Jarvis"
            android:padding="10dp"
            android:src="@drawable/ic_attach"
            app:tint="?attr/themeTextPrimary" />

        <EditText
            android:id="@+id/etHomeInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif"
            android:hint="Jarvis se kuchh bhi poochho..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="6dp"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="?attr/themeTextMuted"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnHomeSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ref_blue_button"
            android:contentDescription="Send"
            android:padding="10dp"
            android:src="@drawable/ic_send_up"
            app:tint="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
