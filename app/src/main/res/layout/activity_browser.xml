<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="26dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_close"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Close browser" />

        <ImageButton
            android:id="@+id/btnWebBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_jarvis_row_item"
            android:src="@drawable/ic_browser_back"
            app:tint="?attr/themeTextSecondary"
            android:contentDescription="Back" />

        <ImageButton
            android:id="@+id/btnWebForward"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_jarvis_row_item"
            android:src="@drawable/ic_browser_forward"
            app:tint="?attr/themeTextSecondary"
            android:contentDescription="Forward" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_browser_address"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="?attr/themeTextMuted"
            android:textSize="12.5sp"
            android:hint="Search or type URL"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:selectAllOnFocus="true" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_jarvis_row_item"
            android:src="@drawable/ic_browser_refresh"
            app:tint="?attr/themeTextSecondary"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressTint="?attr/themeAccent"
        android:background="@android:color/transparent" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF" />
</LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
