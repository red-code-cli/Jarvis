<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_ref_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMemoryCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ref_chip"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.06"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="PREFERENCES"
            android:textColor="?attr/themeAccent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMemoryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sep 12, 2026 • 15:30"
            android:textColor="?attr/themeTextMuted"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/btnEditMemory"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="?attr/themeTextSecondary" />

        <ImageButton
            android:id="@+id/btnDeleteMemory"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/status_red" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMemoryFact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:text="Favorite song is Believer."
        android:textColor="?attr/themeTextPrimary"
        android:textSize="15sp" />

</LinearLayout>
