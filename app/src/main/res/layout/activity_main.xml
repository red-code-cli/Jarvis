<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootShell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/themeBg"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Floating reference top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnTopMenu"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_ref_top_button"
                android:contentDescription="Menu"
                android:elevation="5dp"
                android:src="@drawable/ic_menu"
                app:tint="?attr/themeTextPrimary" />

            <TextView
                android:id="@+id/tvTopTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:includeFontPadding="false"
                android:text="Jarvis"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="29sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageButton
                    android:id="@+id/btnTopApps"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_ref_top_button"
                    android:contentDescription="All apps"
                    android:elevation="5dp"
                    android:src="@drawable/ic_settings_apps"
                    app:tint="?attr/themeTextPrimary" />
            </FrameLayout>

            <FrameLayout
                android:layout_marginStart="8dp"
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageButton
                    android:id="@+id/btnTopBell"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_ref_top_button"
                    android:contentDescription="Updates"
                    android:elevation="5dp"
                    android:src="@drawable/ic_nav_bell"
                    app:tint="?attr/themeTextPrimary" />

                <View
                    android:id="@+id/topBellDot"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_ref_dot_pink" />
            </FrameLayout>
        </LinearLayout>

        <!-- Fragment area for Home, Scanner, Yaadein, Chat, Settings and Updates -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <!-- Floating glass dock matching the reference layout -->
        <LinearLayout
            android:id="@+id/bottomDock"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_ref_dock"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="14dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Home -->
            <FrameLayout
                android:id="@+id/tabHome"
                android:contentDescription="Home tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabHome"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ref_dock_active"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivTabHome"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="Home"
                        android:src="@drawable/ic_nav_home"
                        app:tint="?attr/themeTextPrimary" />

                    <TextView
                        android:id="@+id/tvTabHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Home"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Scanner / Vision -->
            <FrameLayout
                android:id="@+id/tabScan"
                android:contentDescription="Scan tab — camera vision"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabScan"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivTabScan"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="Scan"
                        android:src="@drawable/ic_scan_frame"
                        app:tint="?attr/themeTextMuted" />

                    <TextView
                        android:id="@+id/tvTabScan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Scan"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Voice hero mic -->
            <FrameLayout
                android:id="@+id/tabMic"
                android:contentDescription="Voice — start or stop Jarvis"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/bg_ref_mic_halo" />

                <LinearLayout
                    android:id="@+id/pillTabMic"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/bg_ref_mic"
                    android:elevation="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivTabMic"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Voice"
                        android:src="@drawable/ic_mic_jarvis"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvTabMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- Yaadein / Memory -->
            <FrameLayout
                android:id="@+id/tabMemory"
                android:contentDescription="Yaadein tab — saved memories"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabMemory"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivTabMemory"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="Yaadein"
                        android:src="@drawable/ic_memory_head"
                        app:tint="?attr/themeTextMuted" />

                    <TextView
                        android:id="@+id/tvTabMemory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Yaadein"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Chat -->
            <FrameLayout
                android:id="@+id/tabChat"
                android:contentDescription="Chat tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabChat"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivTabChat"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="Chat"
                        android:src="@drawable/ic_nav_chat"
                        app:tint="?attr/themeTextMuted" />

                    <TextView
                        android:id="@+id/tvTabChat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Chat"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Slide-in navigation drawer -->
    <FrameLayout
        android:id="@+id/drawerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/drawerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66061223"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/drawerPanel"
            android:layout_width="330dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_ref_drawer"
            android:clipChildren="false"
            android:elevation="24dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="28dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <ScrollView
                android:id="@+id/drawerScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_ref_app_icon"
                            android:elevation="4dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Jarvis"
                                android:padding="6dp"
                                android:scaleType="centerInside"
                                android:src="@mipmap/ic_launcher_round" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDrawerTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-rounded"
                                android:text="Jarvis"
                                android:textColor="?attr/themeTextPrimary"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDrawerDeveloper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="by Roshan"
                                android:textColor="?attr/themeTextMuted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/drawerMenuContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/tvDrawerFooter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp"
                        android:text="v1.8.7 · Roshan"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
